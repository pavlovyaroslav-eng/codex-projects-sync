[
  {
    "name": "decompile_function",
    "description": "Decompile function(s) to pseudo-C by name or address.\n\n    Accepts a single target or a list for batch decompilation.\n    Rich response flags attach callees, strings, and/or xrefs to each result.\n    `timeout_sec` applies per target.\n    ",
    "inputSchema": {
      "properties": {
        "binary_name": {
          "title": "Binary Name",
          "type": "string"
        },
        "name_or_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Name Or Address"
        },
        "include_callees": {
          "default": false,
          "title": "Include Callees",
          "type": "boolean"
        },
        "include_strings": {
          "default": false,
          "title": "Include Strings",
          "type": "boolean"
        },
        "include_xrefs": {
          "default": false,
          "title": "Include Xrefs",
          "type": "boolean"
        },
        "timeout_sec": {
          "default": 30,
          "title": "Timeout Sec",
          "type": "integer"
        }
      },
      "required": [
        "binary_name",
        "name_or_address"
      ],
      "title": "decompile_functionArguments",
      "type": "object"
    }
  },
  {
    "name": "search_symbols_by_name",
    "description": "Search symbols by regex pattern (case-insensitive).\n\n    Supports full regex (e.g. ``^main$``, ``func.*init``). Plain substrings\n    still work since they are valid regex.\n\n    Set ``functions_only=True`` to search only function symbols\n    (excludes labels, variables, classes, namespaces).\n    ",
    "inputSchema": {
      "properties": {
        "binary_name": {
          "title": "Binary Name",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "functions_only": {
          "default": false,
          "title": "Functions Only",
          "type": "boolean"
        },
        "offset": {
          "default": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 25,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "binary_name",
        "query"
      ],
      "title": "search_symbols_by_nameArguments",
      "type": "object"
    }
  },
  {
    "name": "search_code",
    "description": "Search decompiled pseudo-C code.\n\n    Modes: semantic (vector similarity, default) or literal (exact match).\n    Results include both mode counts.\n    ",
    "inputSchema": {
      "properties": {
        "binary_name": {
          "title": "Binary Name",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "limit": {
          "default": 5,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "title": "Offset",
          "type": "integer"
        },
        "search_mode": {
          "default": "semantic",
          "enum": [
            "semantic",
            "literal"
          ],
          "title": "Search Mode",
          "type": "string"
        },
        "include_full_code": {
          "default": true,
          "title": "Include Full Code",
          "type": "boolean"
        },
        "preview_length": {
          "default": 500,
          "title": "Preview Length",
          "type": "integer"
        },
        "similarity_threshold": {
          "default": 0.0,
          "title": "Similarity Threshold",
          "type": "number"
        }
      },
      "required": [
        "binary_name",
        "query"
      ],
      "title": "search_codeArguments",
      "type": "object"
    }
  },
