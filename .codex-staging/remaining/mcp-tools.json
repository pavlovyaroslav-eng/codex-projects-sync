  {
    "name": "disassemble",
    "description": "Disassemble instructions at an address. Returns up to `count` instructions (max 200).\n\n    Returns a compact, whitespace-aligned text listing in `listing` (one\n    instruction per line: address, mnemonic, operands).\n    Set `include_bytes=True` to also include the raw instruction bytes (hex) as a\n    column.\n\n    Useful for inspecting raw assembly at any address without needing to know\n    the function name or entry point.\n    ",
    "inputSchema": {
      "properties": {
        "binary_name": {
          "title": "Binary Name",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "count": {
          "default": 20,
          "title": "Count",
          "type": "integer"
        },
        "include_bytes": {
          "default": false,
          "title": "Include Bytes",
          "type": "boolean"
        }
      },
      "required": [
        "binary_name",
        "address"
      ],
      "title": "disassembleArguments",
      "type": "object"
    }
  },
