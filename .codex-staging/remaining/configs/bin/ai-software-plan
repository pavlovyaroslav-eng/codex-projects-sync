#!/usr/bin/env bash
set -Eeuo pipefail
if (($# != 1)) || [[ ! "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9.+:-]*$ ]]; then echo "Usage: ai-software-plan PACKAGE" >&2; exit 64; fi
package="$1"
echo "Configured apt sources:"
apt-cache policy "$package"
echo
echo "Package metadata:"
apt-cache show "$package" | sed -n '1,80p'
echo
echo "Simulated installation (dependencies, size, services if declared by packages):"
apt-get --simulate install "$package"
echo
echo "No package was installed. Use ai-software-install and confirm interactively."
