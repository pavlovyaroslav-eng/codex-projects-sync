#!/usr/bin/env bash
set -Eeuo pipefail
if (($# != 1)) || [[ ! "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9.+:-]*$ ]]; then echo "Usage: ai-software-install PACKAGE" >&2; exit 64; fi
package="$1"
ai-software-plan "$package"
printf 'Type INSTALL to run sudo apt-get install -- %s: ' "$package" >&2
read -r confirmation
if [[ "$confirmation" != "INSTALL" ]]; then
  echo "Installation cancelled."
  exit 2
fi
sudo apt-get install -- "$package"
ai-software-verify "$package"
