#!/usr/bin/env bash
set -Eeuo pipefail

base_url='http://127.0.0.1:8012'
curl --fail --silent --show-error --max-time 10 "${base_url}/health"
printf '\n'
curl --fail --silent --show-error --max-time 10 "${base_url}/v1/models" | jq .
curl --fail --silent --show-error --max-time 120 \
    -H 'Content-Type: application/json' \
    -d '{"model":"qwen3-coder-30b-a3b-q4km","messages":[{"role":"user","content":"Ответь одним словом: работает?"}],"max_tokens":16,"temperature":0}' \
    "${base_url}/v1/chat/completions" | jq .
