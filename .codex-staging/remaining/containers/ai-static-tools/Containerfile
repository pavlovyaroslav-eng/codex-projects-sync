FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip file binutils p7zip-full yara clamav python3 jq \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --retry 5 \
      --output /tmp/capa.zip https://github.com/mandiant/capa/releases/download/v9.4.0/capa-v9.4.0-linux.zip \
    && printf '%s  %s\n' 07800a1d20a21eb18fc98716e2ae81b668e0c9a04defd588c8aa17ea3d3281e4 /tmp/capa.zip | sha256sum --check --strict \
    && unzip -q /tmp/capa.zip -d /opt/capa \
    && install -m 0755 /opt/capa/capa /usr/local/bin/capa \
    && rm -rf /tmp/capa.zip /opt/capa

COPY scan-entry /usr/local/bin/scan-entry
COPY baseline.yar /opt/ai-static-tools/baseline.yar
RUN chmod 0755 /usr/local/bin/scan-entry && chmod 0644 /opt/ai-static-tools/baseline.yar

ENV HOME=/tmp
WORKDIR /tmp
ENTRYPOINT ["/usr/local/bin/scan-entry"]
